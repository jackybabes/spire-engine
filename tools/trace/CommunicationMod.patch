@@ -0,0 +1,60 @@
+package communicationmod.patches;
+
+import com.evacipated.cardcrawl.modthespire.lib.SpirePatch;
+import com.evacipated.cardcrawl.modthespire.lib.SpirePostfixPatch;
+import com.evacipated.cardcrawl.modthespire.lib.SpirePrefixPatch;
+import com.evacipated.cardcrawl.modthespire.lib.SpireReturn;
+import com.megacrit.cardcrawl.actions.unique.DiscoveryAction;
+import com.megacrit.cardcrawl.cards.AbstractCard;
+
+import communicationmod.Harness;
+
+import java.util.ArrayList;
+import java.util.Map;
+import java.util.WeakHashMap;
+
+/**
+ * Local addition: DiscoveryAction rolls its three cards once, like the Rust port.
+ * The base game calls generateCardChoices on every update() while the action is alive, so its
+ * cardRandomRng use depends on frame timing; caching per action keeps the game in step with
+ * the engine (and with itself across replays).
+ */
+public class HarnessDiscoveryPatch {
+    private static final Map<DiscoveryAction, ArrayList<AbstractCard>> CHOICES = new WeakHashMap<>();
+
+    @SpirePatch(clz = DiscoveryAction.class, method = "generateCardChoices")
+    public static class Typed {
+        @SpirePrefixPatch
+        public static SpireReturn<ArrayList<AbstractCard>> Prefix(DiscoveryAction a, AbstractCard.CardType type) {
+            ArrayList<AbstractCard> c = Harness.normalGame ? null : CHOICES.get(a);
+            return c != null ? SpireReturn.Return(c) : SpireReturn.Continue();
+        }
+
+        @SpirePostfixPatch
+        public static ArrayList<AbstractCard> Postfix(ArrayList<AbstractCard> result, DiscoveryAction a, AbstractCard.CardType type) {
+            if (Harness.normalGame) {
+                return result;
+            }
+            CHOICES.putIfAbsent(a, result);
+            return CHOICES.get(a);
+        }
+    }
+
+    @SpirePatch(clz = DiscoveryAction.class, method = "generateColorlessCardChoices")
+    public static class Colorless {
+        @SpirePrefixPatch
+        public static SpireReturn<ArrayList<AbstractCard>> Prefix(DiscoveryAction a) {
+            ArrayList<AbstractCard> c = Harness.normalGame ? null : CHOICES.get(a);
+            return c != null ? SpireReturn.Return(c) : SpireReturn.Continue();
+        }
+
+        @SpirePostfixPatch
+        public static ArrayList<AbstractCard> Postfix(ArrayList<AbstractCard> result, DiscoveryAction a) {
+            if (Harness.normalGame) {
+                return result;
+            }
+            CHOICES.putIfAbsent(a, result);
+            return CHOICES.get(a);
+        }
+    }
+}
diff --git a/src/main/java/communicationmod/patches/HarnessEndBattleHealPatch.java b/src/main/java/communicationmod/patches/HarnessEndBattleHealPatch.java
