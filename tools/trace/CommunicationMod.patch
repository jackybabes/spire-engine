diff --git a/src/main/java/communicationmod/Advisor.java b/src/main/java/communicationmod/Advisor.java
new file mode 100644
index 0000000..94d6cd1
--- /dev/null
+++ b/src/main/java/communicationmod/Advisor.java
@@ -0,0 +1,60 @@
+package communicationmod;
+
+import com.badlogic.gdx.Gdx;
+import com.badlogic.gdx.Input;
+import com.badlogic.gdx.graphics.Color;
+import com.badlogic.gdx.graphics.g2d.SpriteBatch;
+import com.google.gson.Gson;
+import com.megacrit.cardcrawl.core.Settings;
+import com.megacrit.cardcrawl.helpers.FontHelper;
+import com.megacrit.cardcrawl.helpers.ImageMaster;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+/**
+ * Local addition: the advisor box. The external process (tools/advisor/advisor.py) sends
+ * `advice <JSON list of lines>` after each game state; the box shows them in the top-left corner,
+ * under the top bar, until the next advice. F9 hides or shows it.
+ */
+public class Advisor {
+    private static List<String> lines = new ArrayList<>();
+    private static boolean visible = true;
+    private static final Color BOX = new Color(0.0f, 0.0f, 0.0f, 0.65f);
+    private static final Color TITLE = new Color(1.0f, 0.85f, 0.45f, 1.0f);
+
+    public static void set(String json) {
+        try {
+            String[] parsed = new Gson().fromJson(json, String[].class);
+            lines = parsed == null ? new ArrayList<>() : new ArrayList<>(Arrays.asList(parsed));
+        } catch (RuntimeException e) {
+            lines = new ArrayList<>(Arrays.asList("advisor: bad advice", json));
+        }
+    }
+
+    public static void update() {
+        if (Gdx.input.isKeyJustPressed(Input.Keys.F9)) {
+            visible = !visible;
+        }
+    }
+
+    public static void render(SpriteBatch sb) {
+        if (!visible || lines.isEmpty()) {
+            return;
+        }
+        float lineH = 30.0f * Settings.scale;
+        float pad = 12.0f * Settings.scale;
+        float w = 560.0f * Settings.scale;
+        float h = lines.size() * lineH + 2 * pad;
+        float x = 20.0f * Settings.scale;
+        float top = Settings.HEIGHT - 190.0f * Settings.scale;
+        sb.setColor(BOX);
+        sb.draw(ImageMaster.WHITE_SQUARE_IMG, x, top - h, w, h);
+        for (int i = 0; i < lines.size(); i++) {
+            Color c = i == 0 ? TITLE : Settings.CREAM_COLOR;
+            FontHelper.renderFontLeftTopAligned(sb, FontHelper.tipBodyFont, lines.get(i), x + pad, top - pad - i * lineH, c);
+        }
+        sb.setColor(Color.WHITE);
+    }
+}
