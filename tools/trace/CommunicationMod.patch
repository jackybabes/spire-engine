new file mode 100644
index 0000000..1d60756
--- /dev/null
+++ b/src/main/java/communicationmod/Harness.java
@@ -0,0 +1,192 @@
+package communicationmod;
+
+import com.google.gson.Gson;
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.megacrit.cardcrawl.cards.AbstractCard;
+import com.megacrit.cardcrawl.core.Settings;
+import com.megacrit.cardcrawl.dungeons.AbstractDungeon;
+import com.megacrit.cardcrawl.helpers.CardLibrary;
+import com.megacrit.cardcrawl.map.MapEdge;
+import com.megacrit.cardcrawl.map.MapRoomNode;
+import com.megacrit.cardcrawl.monsters.AbstractMonster;
+import com.megacrit.cardcrawl.random.Random;
+import com.megacrit.cardcrawl.rooms.MonsterRoom;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+
+/**
+ * Validation hooks for the Rust port (local addition, not upstream CommunicationMod).
+ *
+ * "harness {json}" sets the master deck and HP, then starts a fight like BaseMod's `fight`
+ * console command: {"deck":[["Strike_R",0],...],"hp":80,"max_hp":80,"encounter":"Jaw Worm"}.
+ * "harness {\"abandon\":true}" abandons the current run.
+ */
+public class Harness {
+    public static float speed = 1.0f;
+    /** Local addition: game updates per drawn frame ("harness {\"ticks\": N}"). With more than one,
+     * every update advances the game by a fixed 1/60 s times `speed` (HarnessSpeedPatch) instead
+     * of the frame's real time, and the frame runs N of them before drawing once
+     * (HarnessTicksPatch): the game's own code runs tick by tick as at normal speed, only fewer
+     * frames are drawn. */
+    public static int ticks = 1;
+    public static final float TICK = 1.0f / 60.0f;
+    /** Local addition: the advisor is connected and a person is playing, so the harness's changes
+     * to the game (Note For Yourself's card, the Courier's restock, discovery rolling once) are off. */
+    public static boolean normalGame = false;
+
+    public static void execute(String json) throws InvalidCommandException {
+        JsonObject o = new Gson().fromJson(json, JsonObject.class);
+        for (String k : new ArrayList<>(com.megacrit.cardcrawl.helpers.TipTracker.tips.keySet())) {
+            com.megacrit.cardcrawl.helpers.TipTracker.neverShowAgain(k);
+        }
+        Settings.FAST_MODE = true;
+        Settings.MASTER_VOLUME = 0.0f;
+        if (o.has("speed")) {
+            speed = o.get("speed").getAsFloat();
+        }
+        if (o.has("ticks")) {
+            ticks = Math.max(1, o.get("ticks").getAsInt());
+        }
+        if (o.has("abandon")) {
+            // Same as Settings > Abandon Run.
+            AbstractDungeon.closeCurrentScreen();
+            AbstractDungeon.player.isDead = true;
+            AbstractDungeon.deathScreen = new com.megacrit.cardcrawl.screens.DeathScreen(AbstractDungeon.getMonsters());
+            return;
+        }
+        if (AbstractDungeon.currMapNode == null) {
+            throw new InvalidCommandException("harness needs a map node");
+        }
+        if (o.has("deck")) {
+            AbstractDungeon.player.masterDeck.clear();
+            for (JsonElement e : o.getAsJsonArray("deck")) {
+                JsonArray pair = e.getAsJsonArray();
+                AbstractCard c = CardLibrary.getCard(pair.get(0).getAsString());
+                if (c == null) {
+                    throw new InvalidCommandException("unknown card " + pair.get(0).getAsString());
+                }
+                c = c.makeCopy();
+                for (int i = 0; i < pair.get(1).getAsInt(); i++) {
+                    c.upgrade();
+                }
+                AbstractDungeon.player.masterDeck.addToTop(c);
+            }
+        }
+        if (o.has("max_hp")) {
+            AbstractDungeon.player.maxHealth = o.get("max_hp").getAsInt();
+        }
+        if (o.has("hp")) {
+            AbstractDungeon.player.currentHealth = o.get("hp").getAsInt();
+        }
+        if (o.has("relics")) {
+            // Replace the relics, running each onEquip (energy, hand size, counters).
+            AbstractDungeon.player.relics.clear();
+            // Undo earlier fights' onEquip effects (relics are cleared without onUnequip).
+            AbstractDungeon.player.energy.energyMaster = 3;
+            AbstractDungeon.player.masterHandSize = 5;
+            AbstractDungeon.player.potionSlots = 3;
+            for (JsonElement e : o.getAsJsonArray("relics")) {
+                com.megacrit.cardcrawl.relics.AbstractRelic r = com.megacrit.cardcrawl.helpers.RelicLibrary.getRelic(e.getAsString()).makeCopy();
+                r.instantObtain(AbstractDungeon.player, AbstractDungeon.player.relics.size(), true);
+            }
+        }
+        if (o.has("potions")) {
+            for (int i = 0; i < AbstractDungeon.player.potionSlots; i++) {
+                AbstractDungeon.player.potions.set(i, new com.megacrit.cardcrawl.potions.PotionSlot(i));
+            }
+            for (JsonElement e : o.getAsJsonArray("potions")) {
+                AbstractDungeon.player.obtainPotion(com.megacrit.cardcrawl.helpers.PotionHelper.getPotion(e.getAsString()));
+            }
+        }
+        if (o.has("encounter")) {
+            String encounter = o.get("encounter").getAsString();
+            MapRoomNode cur = AbstractDungeon.currMapNode;
+            if (AbstractDungeon.getCurrRoom() instanceof MonsterRoom) {
+                AbstractDungeon.monsterList.add(1, encounter);
+            } else {
+                AbstractDungeon.monsterList.add(0, encounter);
+            }
+            MapRoomNode node = new MapRoomNode(cur.x, cur.y);
+            node.room = new MonsterRoom();
+            for (MapEdge edge : cur.getEdges()) {
+                node.addEdge(edge);
+            }
+            AbstractDungeon.nextRoom = node;
+            AbstractDungeon.nextRoomTransitionStart();
+        }
+    }
+
+    private static HashMap<String, Object> rng(Random r) {
+        HashMap<String, Object> m = new HashMap<>();
+        m.put("counter", r.counter);
+        m.put("s0", Long.toString(r.random.getState(0)));
+        m.put("s1", Long.toString(r.random.getState(1)));
+        return m;
+    }
+
+    /** Extra internal state for diffing against the port. */
+    public static HashMap<String, Object> state() {
+        HashMap<String, Object> s = new HashMap<>();
+        s.put("seed", Long.toString(Settings.seed));
+        s.put("floor", AbstractDungeon.floorNum);
+        HashMap<String, Object> rngs = new HashMap<>();
+        rngs.put("monster_hp", rng(AbstractDungeon.monsterHpRng));
+        rngs.put("ai", rng(AbstractDungeon.aiRng));
+        rngs.put("shuffle", rng(AbstractDungeon.shuffleRng));
+        rngs.put("card_random", rng(AbstractDungeon.cardRandomRng));
+        rngs.put("misc", rng(AbstractDungeon.miscRng));
+        rngs.put("monster", rng(AbstractDungeon.monsterRng));
+        rngs.put("event", rng(AbstractDungeon.eventRng));
+        rngs.put("merchant", rng(AbstractDungeon.merchantRng));
+        rngs.put("card", rng(AbstractDungeon.cardRng));
+        rngs.put("treasure", rng(AbstractDungeon.treasureRng));
+        rngs.put("relic", rng(AbstractDungeon.relicRng));
+        rngs.put("potion", rng(AbstractDungeon.potionRng));
+        if (AbstractDungeon.mapRng != null) {
+            rngs.put("map", rng(AbstractDungeon.mapRng));
+        }
+        s.put("rng", rngs);
+        s.put("card_blizz", AbstractDungeon.cardBlizzRandomizer);
+        s.put("potion_blizz", com.megacrit.cardcrawl.rooms.AbstractRoom.blizzardPotionMod);
+        s.put("event_chances", com.megacrit.cardcrawl.helpers.EventHelper.getChances());
+        s.put("monster_list", new ArrayList<>(AbstractDungeon.monsterList));
+        s.put("elite_list", new ArrayList<>(AbstractDungeon.eliteMonsterList));
+        s.put("boss_list", new ArrayList<>(AbstractDungeon.bossList));
+        HashMap<String, Object> pools = new HashMap<>();
+        pools.put("common", new ArrayList<>(AbstractDungeon.commonRelicPool));
+        pools.put("uncommon", new ArrayList<>(AbstractDungeon.uncommonRelicPool));
+        pools.put("rare", new ArrayList<>(AbstractDungeon.rareRelicPool));
+        pools.put("shop", new ArrayList<>(AbstractDungeon.shopRelicPool));
+        pools.put("boss", new ArrayList<>(AbstractDungeon.bossRelicPool));
+        s.put("relic_pools", pools);
+        if (AbstractDungeon.player != null) {
+            ArrayList<Object> deck = new ArrayList<>();
+            for (AbstractCard c : AbstractDungeon.player.masterDeck.group) {
+                deck.add(c.cardID + "+" + c.timesUpgraded);
+            }
+            s.put("master_deck", deck);
+        }
+        if (AbstractDungeon.getCurrRoom() != null && AbstractDungeon.getCurrRoom().monsters != null) {
+            ArrayList<Object> ms = new ArrayList<>();
+            for (AbstractMonster m : AbstractDungeon.getCurrRoom().monsters.monsters) {
+                HashMap<String, Object> j = new HashMap<>();
+                j.put("id", m.id);
+                j.put("next_move", m.nextMove);
+                j.put("move_history", new ArrayList<>(m.moveHistory));
+                ArrayList<Integer> dmg = new ArrayList<>();
+                for (com.megacrit.cardcrawl.cards.DamageInfo d : m.damage) {
+                    dmg.add(d.output);
+                }
+                j.put("damage_outputs", dmg);
+                j.put("is_dying", m.isDying);
+                j.put("is_escaping", m.isEscaping);
+                ms.add(j);
+            }
+            s.put("monsters", ms);
+        }
+        return s;
+    }
+}
diff --git a/src/main/java/communicationmod/patches/HarnessCourierPatch.java b/src/main/java/communicationmod/patches/HarnessCourierPatch.java
new file mode 100644
index 0000000..15dc9b3
--- /dev/null
+++ b/src/main/java/communicationmod/patches/HarnessCourierPatch.java
@@ -0,0 +1,58 @@
+package communicationmod.patches;
+
+import com.evacipated.cardcrawl.modthespire.lib.SpirePatch;
+import com.evacipated.cardcrawl.modthespire.lib.SpirePostfixPatch;
+import communicationmod.Harness;
+import com.evacipated.cardcrawl.modthespire.lib.SpirePrefixPatch;
+import com.evacipated.cardcrawl.modthespire.lib.SpireReturn;
+import com.megacrit.cardcrawl.cards.AbstractCard;
+import com.megacrit.cardcrawl.core.Settings;
+import com.megacrit.cardcrawl.dungeons.AbstractDungeon;
+import com.megacrit.cardcrawl.random.Random;
+
+/**
+ * Local addition: The Courier's shop restock picks its card from a seeded stream, like the Rust
+ * port. The base game rolls the restock's rarity with cardRng but picks the card with
+ * getCardFromPool(rarity, type, useRng = false), i.e. MathUtils.random, so a run that buys a
+ * restocked card can't be reproduced. Here that pick comes from Random(seed ^ COURIER_SEED_XOR)
+ * (the engine's Rngs::courier), created afresh whenever the game seeds a run. Only the restock
+ * calls getCardFromPool with useRng = false.
+ */
+public class HarnessCourierPatch {
+    /** crates/sts-core/src/rngs.rs COURIER_SEED_XOR ("Courier!"). */
+    private static final long COURIER_SEED_XOR = 0x436F757269657221L;
+    private static Random courier;
+    private static boolean inside;
+
+    @SpirePatch(clz = AbstractDungeon.class, method = "generateSeeds")
+    public static class Seed {
+        @SpirePostfixPatch
+        public static void Postfix() {
+            courier = new Random(Settings.seed ^ COURIER_SEED_XOR);
+        }
+    }
+
+    @SpirePatch(clz = AbstractDungeon.class, method = "getCardFromPool")
+    public static class Pick {
+        @SpirePrefixPatch
+        public static SpireReturn<AbstractCard> Prefix(AbstractCard.CardRarity rarity, AbstractCard.CardType type, boolean useRng) {
+            if (useRng || inside || Harness.normalGame) {
+                return SpireReturn.Continue();
+            }
+            if (courier == null) {
+                courier = new Random(Settings.seed ^ COURIER_SEED_XOR);
+            }
+            // The same pick with cardRng swapped for the courier stream (getRandomCard(type, true)
+            // draws from AbstractDungeon.cardRng).
+            Random saved = AbstractDungeon.cardRng;
+            inside = true;
+            try {
+                AbstractDungeon.cardRng = courier;
+                return SpireReturn.Return(AbstractDungeon.getCardFromPool(rarity, type, true));
+            } finally {
+                AbstractDungeon.cardRng = saved;
+                inside = false;
+            }
+        }
+    }
+}
