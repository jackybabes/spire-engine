index 0000000..3032a0f
--- /dev/null
+++ b/src/main/java/communicationmod/patches/HarnessSpeedPatch.java
@@ -0,0 +1,20 @@
+package communicationmod.patches;
+
+import com.badlogic.gdx.backends.lwjgl.LwjglGraphics;
+import com.evacipated.cardcrawl.modthespire.lib.SpirePatch;
+import com.evacipated.cardcrawl.modthespire.lib.SpirePostfixPatch;
+import communicationmod.Harness;
+
+/** Local addition: scales frame time so recorded fights resolve faster. With Harness.ticks above
+ * 1, every update's time is a fixed 1/60 s times the speed instead (the frame's real time grows
+ * with the updates it runs, and a long step is what makes the game skip states). */
+@SpirePatch(clz = LwjglGraphics.class, method = "getDeltaTime")
+public class HarnessSpeedPatch {
+    @SpirePostfixPatch
+    public static float Postfix(float result, LwjglGraphics instance) {
+        if (Harness.ticks > 1) {
+            return Harness.TICK * Harness.speed;
+        }
+        return result * Harness.speed;
+    }
+}
diff --git a/src/main/java/communicationmod/patches/HarnessTicksPatch.java b/src/main/java/communicationmod/patches/HarnessTicksPatch.java
new file mode 100644
index 0000000..3293a3f
--- /dev/null
+++ b/src/main/java/communicationmod/patches/HarnessTicksPatch.java
@@ -0,0 +1,29 @@
+package communicationmod.patches;
+
+import com.badlogic.gdx.Gdx;
+import com.evacipated.cardcrawl.modthespire.lib.SpirePatch;
+import com.evacipated.cardcrawl.modthespire.lib.SpirePrefixPatch;
+import com.megacrit.cardcrawl.core.CardCrawlGame;
+import communicationmod.Harness;
+
+/**
+ * Local addition: with Harness.ticks = N above 1, each frame runs the game's update N times and
+ * draws once. CardCrawlGame.render() updates once and draws; this runs the other N - 1 updates
+ * first. Each update is the game's own (BaseMod's hooks and so CommunicationMod's commands
+ * included) and advances a fixed 1/60 s (HarnessSpeedPatch), so the game goes through the same
+ * states as at normal speed, N times as fast, where a larger time step (`speed`) skips states:
+ * at speed 10 a discovered card never reached the hand. render() skips frames whose real time
+ * is over 0.1 s; so does this.
+ */
+@SpirePatch(clz = CardCrawlGame.class, method = "render")
+public class HarnessTicksPatch {
+    @SpirePrefixPatch
+    public static void Prefix(CardCrawlGame __instance) {
+        if (Harness.ticks <= 1 || Gdx.graphics.getRawDeltaTime() > 0.1f) {
+            return;
+        }
+        for (int i = 1; i < Harness.ticks; i++) {
+            __instance.update();
+        }
+    }
+}
