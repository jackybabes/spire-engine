@@ -0,0 +1,36 @@
+package communicationmod.patches;
+
+import com.evacipated.cardcrawl.modthespire.lib.SpirePatch;
+import com.evacipated.cardcrawl.modthespire.lib.SpirePostfixPatch;
+import communicationmod.Harness;
+import com.megacrit.cardcrawl.cards.red.IronWave;
+import com.megacrit.cardcrawl.events.shrines.NoteForYourself;
+
+import java.lang.reflect.Field;
+
+/**
+ * Local addition: Note For Yourself always offers an unupgraded Iron Wave, like the Rust port.
+ * The base game offers the card the profile saved (playerPref NOTE_CARD / NOTE_UPGRADE, written
+ * when a run that took the note ends), so recorded and played-back runs would depend on the runs
+ * before them. Iron Wave is the game's own default when nothing is saved.
+ */
+@SpirePatch(clz = NoteForYourself.class, method = "initializeObtainCard")
+public class HarnessNotePatch {
+    private static Field obtainCard;
+
+    @SpirePostfixPatch
+    public static void Postfix(NoteForYourself event) {
+        if (Harness.normalGame) {
+            return;
+        }
+        try {
+            if (obtainCard == null) {
+                obtainCard = NoteForYourself.class.getDeclaredField("obtainCard");
+                obtainCard.setAccessible(true);
+            }
+            obtainCard.set(event, new IronWave());
+        } catch (ReflectiveOperationException e) {
+            throw new RuntimeException("HarnessNotePatch: can't set NoteForYourself.obtainCard", e);
+        }
+    }
+}
