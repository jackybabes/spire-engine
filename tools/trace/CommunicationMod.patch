@@ -0,0 +1,28 @@
+package communicationmod.patches;
+
+import com.evacipated.cardcrawl.modthespire.lib.SpirePatch;
+import com.evacipated.cardcrawl.modthespire.lib.SpirePostfixPatch;
+import com.megacrit.cardcrawl.actions.AbstractGameAction;
+import com.megacrit.cardcrawl.dungeons.AbstractDungeon;
+import communicationmod.Harness;
+
+/**
+ * Local addition: an action that opens a selection screen waits for the choice, as it does at
+ * normal speed. Such actions open the screen and tick their duration in the same update; actions
+ * don't update again until the screen closes, and then they handle the choice. At harness speed
+ * one frame's time can exceed a short action's whole duration (DiscardAction and NightmareAction
+ * last 0.1 s), so the action finished in that first update and the chosen card was never handled:
+ * it stayed in the screen's selected group, in no pile (2026-10-19, the Silent's discard choices).
+ */
+@SpirePatch(clz = AbstractGameAction.class, method = "tickDuration")
+public class HarnessSelectScreenPatch {
+    @SpirePostfixPatch
+    public static void Postfix(AbstractGameAction action) {
+        if (Harness.normalGame || Harness.speed <= 1.0f) {
+            return;
+        }
+        if (action.isDone && AbstractDungeon.isScreenUp && action == AbstractDungeon.actionManager.currentAction) {
+            action.isDone = false;
+        }
+    }
+}
