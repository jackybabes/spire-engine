--- /dev/null
+++ b/src/main/java/communicationmod/patches/HarnessEndBattleHealPatch.java
@@ -0,0 +1,53 @@
+package communicationmod.patches;
+
+import com.evacipated.cardcrawl.modthespire.lib.SpirePatch;
+import com.evacipated.cardcrawl.modthespire.lib.SpirePrefixPatch;
+import com.megacrit.cardcrawl.actions.AbstractGameAction;
+import com.megacrit.cardcrawl.actions.common.HealAction;
+import com.megacrit.cardcrawl.dungeons.AbstractDungeon;
+import com.megacrit.cardcrawl.rooms.AbstractRoom;
+import communicationmod.Harness;
+
+import java.lang.reflect.Field;
+
+/**
+ * Local addition: a heal still queued when the battle ends is applied first, like the Rust port.
+ * The battle ends when the last monster's death animation runs out (AbstractMonster
+ * updateDeathAnimation -> endBattle), and endBattle clears the whole action queue. At normal
+ * speed Reaper's heal (queued behind short waits after the killing blow) has run by then; at
+ * harness speed a long frame can end the battle first and the heal is lost (2026-10-17 soak:
+ * four runs where Reaper killed the last monster, the game healed nothing). Applied before
+ * endBattle's own work, so in the same order as at normal speed (then onVictory relics).
+ */
+@SpirePatch(clz = AbstractRoom.class, method = "endBattle")
+public class HarnessEndBattleHealPatch {
+    private static Field duration, startDuration;
+
+    /** Whether the action hasn't run its first update yet (HealAction heals on that update). */
+    private static boolean notStarted(AbstractGameAction a) {
+        try {
+            if (duration == null) {
+                duration = AbstractGameAction.class.getDeclaredField("duration");
+                startDuration = AbstractGameAction.class.getDeclaredField("startDuration");
+                duration.setAccessible(true);
+                startDuration.setAccessible(true);
+            }
+            return duration.getFloat(a) == startDuration.getFloat(a);
+        } catch (ReflectiveOperationException e) {
+            return false;
+        }
+    }
+
+    @SpirePrefixPatch
+    public static void Prefix(AbstractRoom room) {
+        if (Harness.normalGame || Harness.speed <= 1.0f) {
+            return;
+        }
+        for (AbstractGameAction a : AbstractDungeon.actionManager.actions) {
+            if (a instanceof HealAction && a.target == AbstractDungeon.player && a.amount > 0 && notStarted(a)) {
+                AbstractDungeon.player.heal(a.amount);
+                a.isDone = true;
+            }
+        }
+    }
+}
