@@ -0,0 +1,30 @@
+package communicationmod.patches;
+
+import com.evacipated.cardcrawl.modthespire.lib.SpirePatch;
+import com.evacipated.cardcrawl.modthespire.lib.SpirePrefixPatch;
+import com.evacipated.cardcrawl.modthespire.lib.SpireReturn;
+import com.megacrit.cardcrawl.cards.AbstractCard;
+import com.megacrit.cardcrawl.dungeons.AbstractDungeon;
+import com.megacrit.cardcrawl.helpers.CardLibrary;
+import com.megacrit.cardcrawl.random.Random;
+import communicationmod.Harness;
+
+/**
+ * Local addition: the transform grid's preview of a curse doesn't draw from cardRng, like the
+ * Rust port. While a card waits selected on a transform grid, GridCardSelectScreen re-rolls its
+ * preview every 0.1 s with returnTrulyRandomCardFromAvailable(card), which for a curse calls
+ * CardLibrary.getCurse() on AbstractDungeon.cardRng. So transforming a curse costs as many
+ * cardRng draws as the selection lasts tenths of a second, and the next card roll (rewards,
+ * shops) depends on timing (2026-10-17 soak: 5 draws before the confirm). This one-argument
+ * overload is only that preview's; the transform itself goes through the overload with an rng.
+ */
+@SpirePatch(clz = AbstractDungeon.class, method = "returnTrulyRandomCardFromAvailable", paramtypez = {AbstractCard.class})
+public class HarnessTransformPreviewPatch {
+    @SpirePrefixPatch
+    public static SpireReturn<AbstractCard> Prefix(AbstractCard prohibited) {
+        if (Harness.normalGame || prohibited.color != AbstractCard.CardColor.CURSE) {
+            return SpireReturn.Continue();
+        }
+        return SpireReturn.Return(CardLibrary.getCurse(prohibited, new Random()));
+    }
+}
